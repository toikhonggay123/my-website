---
interface Props { name: string; size?: number; }
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'external' && <path d="M6 18 18 6M7 6h11v11" />}
  {name === 'down' && <path d="M12 4v15m-6-6 6 6 6-6" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></>}
  {name === 'play' && <path d="m8 5 12 7-12 7V5Z" />}
  {name === 'pause' && <path d="M9 5v14m6-14v14" />}
</svg>
