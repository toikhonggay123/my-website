---
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import Glass from '../aurora/Glass.astro';
---
<Site title="Không tìm thấy trang · AFYLLX" description="Quay lại website AFYLLX để chọn một trong ba mảng.">
  <div class="au au-home" data-aurora-zone data-cycle>
    <Glass />

    <section class="c2-hero" aria-labelledby="page-title">
      <div class="wrap c2-copy">
        <h1 id="page-title"><span class="ln"><span>Không tìm thấy trang</span></span></h1>
        <p class="au-lead" data-in>Đường dẫn này không còn hoặc chưa từng có trên website AFYLLX.</p>
        <div class="au-actions" data-in>
          <a class="button button-primary" href="/">Về trang chủ <Icon name="arrow" size={18} /></a>
          <a class="text-link" href="/#linh-vuc">Xem các lĩnh vực</a>
        </div>
      </div>
    </section>
  </div>
</Site>
