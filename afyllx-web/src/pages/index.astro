---
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import Status from '../components/Status.astro';
import { divisions } from '../data.js';
const stories = [
  { ...divisions[0], headline: ['Công nghệ cho', 'nhịp vận hành', 'nhà trường.'], body: 'Từ những công việc mỗi ngày, mở ra cách tổ chức và vận hành thuận tiện hơn.', cues: ['Nhà trường', 'Con người', 'Vận hành'] },
  { ...divisions[1], headline: ['Từ ý tưởng kinh doanh.', 'Đến một website.'], body: 'Định hướng nền tảng kinh doanh website trực tuyến, kết nối nhu cầu với một không gian số có thể đưa vào sử dụng.', cues: ['Ý tưởng', 'Website', 'Kinh doanh'] },
  { ...divisions[2], headline: ['Hiểu quy trình.', 'Kiến tạo', 'giải pháp số.'], body: 'Định hướng giải pháp chuyển đổi số chính phủ, bắt đầu từ thực tế của từng cơ quan và đơn vị.', cues: ['Quy trình', 'Kết nối', 'Chuyển đổi số'] },
];
const coverText: Record<string, string> = {
  edu: 'Công nghệ cho vận hành nhà trường.',
  digital: 'Nền tảng kinh doanh website.',
  gov: 'Chuyển đổi số khu vực công.',
};
const approach = [
  { title: 'Hiểu nhu cầu.', text: 'Bắt đầu với người thực hiện và công việc họ cần hoàn thành.' },
  { title: 'Xác định phạm vi.', text: 'Chọn bài toán, kết quả cần đạt và phần việc nên làm trước.' },
  { title: 'Dựng giải pháp.', text: 'Kết nối trải nghiệm, thiết kế và công nghệ trong một sản phẩm.' },
  { title: 'Hoàn thiện.', text: 'Quan sát cách sử dụng và tiếp tục cải thiện từ thực tế.' },
];
---
<Site title="AFYLLX · Xây nền tảng số cho công việc thực tế" description="AFYLLX phát triển công nghệ cho nhà trường, kinh doanh website trực tuyến và chuyển đổi số khu vực công.">
  <section class="cover" aria-labelledby="hero-title">
    <div class="wrap cover-hero">
      <div class="cover-copy">
        <span class="cover-eyebrow">Tổng quan AFYLLX</span>
        <h1 id="hero-title">Xây nền tảng số<br />cho <b>công việc</b><br /><b>thực tế.</b></h1>
        <p>Công nghệ cho nhà trường, kinh doanh website<br class="desktop-break" /> trực tuyến và chuyển đổi số khu vực công.</p>
        <div class="cover-actions">
          <a class="pill pill-solid" href="#kham-pha">Khám phá các lĩnh vực</a>
          <a class="pill pill-line" href="/ve-afyllx">Về AFYLLX</a>
        </div>
      </div>
      <div class="cover-stage" aria-hidden="true">
        <span class="ring ring-outer"></span><span class="ring ring-inner"></span><span class="cover-glow"></span>
        <img src="/afyllx-brand/afyllx-logo.png" width="640" height="640" alt="" fetchpriority="high" />
      </div>
    </div>
    <div class="wrap cover-chapters">
      {divisions.map((division, index) => (
        <a class:list={['cover-chapter', { 'is-active': index === 0 }]} href={`#chuong-${division.id}`}>
          <span class="cover-eyebrow">Chương {index + 1} / 3</span>
          <strong>{division.name}</strong>
          <span class="cover-desc">{coverText[division.id]}</span>
          <span class:list={['cover-tag', { live: division.status === 'Đã triển khai' }]}>{division.status}</span>
          {index === 0 && <span class="cover-progress"><i></i></span>}
        </a>
      ))}
    </div>
  </section>

  <section class="intro-block section-pad" id="kham-pha" aria-labelledby="intro-title">
    <div class="wrap intro-copy" data-reveal>
      <span class="eyebrow">KHẢ NĂNG BẮT ĐẦU TỪ NHU CẦU</span>
      <h2 id="intro-title">Một công việc.<br /><span>Một cách làm tốt hơn.</span></h2>
      <p>Từ vận hành nhà trường đến kinh doanh trên web và chuyển đổi số khu vực công. AFYLLX phát triển theo ba hướng, cùng bắt đầu từ người dùng và công việc thực tế.</p>
    </div>
  </section>

  <section class="stage" data-stage data-current="edu" aria-label="Ba lĩnh vực AFYLLX">
    {divisions.map((division, index) => <span class="stage-anchor" id={`chuong-${division.id}`} style={`--at:${index}`}></span>)}
    <div class="stage-sticky">
      <div class="stage-art" aria-hidden="true">
        {divisions.map((division) => (
          <picture class="stage-poster" data-stage-poster={division.id}>
            <source media="(max-width: 760px)" srcset={`/afyllx-media/depth-${division.id}-mobile.webp`} />
            <img src={`/afyllx-media/depth-${division.id}.webp`} width="2400" height="1500" alt="" loading="lazy" />
          </picture>
        ))}
        <canvas data-stage-canvas></canvas>
      </div>
      <div class="wrap stage-layout">
        {stories.map((story) => (
          <article class="stage-copy" data-stage-copy={story.id} aria-labelledby={`title-${story.id}`}>
            <div class="chapter-meta" data-stage-reveal><span class="eyebrow">CHƯƠNG {Number(story.number)} / 3 · AFYLLX {story.name.toUpperCase()}</span><Status id={story.id} status={story.status} /></div>
            <h2 id={`title-${story.id}`} data-stage-reveal>{story.headline.map((line, index) => <span class:list={{ 'chapter-accent': index === story.headline.length - 1 }}>{line}</span>)}</h2>
            <p data-stage-reveal>{story.body}</p>
            <ol class="stage-steps" data-stage-reveal aria-label="Các bước">{story.cues.map((cue, index) => <li data-stage-step><small>0{index + 1}</small>{cue}</li>)}</ol>
            <a class="text-link" href={`/${story.id}`} data-stage-reveal>Khám phá {story.name} <span class="round-arrow"><Icon name="external" size={17} /></span></a>
          </article>
        ))}
      </div>
      <div class="wrap stage-bottom">
        <nav class="stage-rail" aria-label="Chuyển chương">
          {divisions.map((division, index) => <a href={`#chuong-${division.id}`} data-stage-link={index}><span>Chương {index + 1}</span><strong>{division.name}</strong><i></i></a>)}
        </nav>
        <button type="button" class="stage-motion" data-motion-toggle hidden aria-pressed="false">Giảm chuyển động</button>
      </div>
    </div>
  </section>

  <section class="ecosystem section-pad" id="linh-vuc" aria-labelledby="ecosystem-title">
    <div class="wrap">
      <div class="section-heading" data-reveal><span class="eyebrow"><span class="glow-dot"></span> HỆ SINH THÁI AFYLLX</span><h2 id="ecosystem-title">Ba lĩnh vực.<br /><em>Cùng mở ra phía trước.</em></h2><p>Mỗi lĩnh vực có trọng tâm riêng, cùng hướng đến những giải pháp số có thể sử dụng trong thực tế.</p></div>
      <div class="ecosystem-grid">
        {divisions.map((division) => <a class:list={['ecosystem-card', `theme-${division.id}`]} href={`/${division.id}`} data-light-card>
          <div class="ecosystem-art"><img src={`/afyllx-media/sculpture-${division.id}.webp`} width="960" height="720" alt="" loading="lazy" /><span class="ecosystem-number" aria-hidden="true">{division.number}</span></div>
          <div class="ecosystem-copy"><Status id={division.id} status={division.status} /><h3>AFYLLX {division.name}<Icon name="external" size={21} /></h3><p>{division.description}</p></div>
        </a>)}
      </div>
    </div>
  </section>

  <section class="approach section-pad" aria-labelledby="approach-title">
    <div class="wrap">
      <div class="approach-heading" data-reveal><span class="eyebrow">TỪ MỘT BÀI TOÁN ĐẾN GIẢI PHÁP</span><h2 id="approach-title">Bắt đầu bằng<br /><em>việc hiểu rõ hơn.</em></h2><a class="text-link" href="/ve-afyllx">Cách AFYLLX tiếp cận <span class="round-arrow"><Icon name="external" size={17} /></span></a></div>
      <ol class="approach-grid">{approach.map((step, index) => <li data-reveal><span class="step-number">0{index + 1}</span><div class="step-light" aria-hidden="true"></div><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
    </div>
  </section>

  <section class="connection" aria-labelledby="connection-title">
    <div class="connection-orbit" aria-hidden="true"></div>
    <div class="wrap connection-content" data-reveal><span class="eyebrow"><span class="glow-dot"></span> KẾT NỐI VỚI AFYLLX</span><h2 id="connection-title">Điều gì sẽ<br /><em>bắt đầu tiếp theo?</em></h2><p>Chia sẻ nhu cầu của bạn. Cùng xác định một hướng đi.</p><a class="button button-primary" href="/lien-he">Trao đổi với AFYLLX <Icon name="external" size={18} /></a><div class="connection-topics">{divisions.map((division) => <a href={`/lien-he?chu-de=${division.id}`}>{division.name}<Icon name="external" size={13} /></a>)}</div></div>
  </section>
</Site>
<script>
  import '../motion/stage-journey.js';
</script>
