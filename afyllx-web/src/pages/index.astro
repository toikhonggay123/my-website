---
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import Status from '../components/Status.astro';
import { divisions } from '../data.js';
import { hero, manifest, stories } from '../aurora/content.js';
import Glass from '../aurora/Glass.astro';
const approach = [
  { title: 'Hiểu nhu cầu', text: 'Bắt đầu với người thực hiện và công việc họ cần hoàn thành.' },
  { title: 'Xác định phạm vi', text: 'Chọn bài toán, kết quả cần đạt và phần việc nên làm trước.' },
  { title: 'Dựng giải pháp', text: 'Kết nối trải nghiệm, thiết kế và công nghệ trong một sản phẩm.' },
  { title: 'Hoàn thiện', text: 'Quan sát cách sử dụng và tiếp tục cải thiện từ thực tế.' },
];
---
<Site title="AFYLLX · Xây nền tảng số cho công việc thực tế" description="AFYLLX phát triển công nghệ cho nhà trường, kinh doanh website trực tuyến và chuyển đổi số khu vực công.">
  <div class="au au-home" data-aurora-zone>
    <Glass />

    <section class="c2-hero" aria-labelledby="hero-title">
      <div class="wrap c2-copy">
        <h1 id="hero-title">
          <span class="ln"><span>Xây nền tảng số</span></span>
          <span class="ln"><span>cho công việc</span></span>
          <span class="ln"><span>thực tế</span></span>
        </h1>
        <p class="au-lead" data-in>{hero.body}</p>
        <div class="au-actions" data-in>
          <a class="button button-primary" href="#kham-pha">Khám phá các lĩnh vực</a>
        </div>
      </div>
    </section>

    <section class="au-manifest c2" id="kham-pha" aria-label="AFYLLX làm gì">
      <div class="wrap"><p>{manifest}</p></div>
    </section>

    {stories.map((s) => (
      <section class="au-field c2" id={`chuong-${s.id}`} data-field={s.id} aria-labelledby={`title-${s.id}`}>
        <div class="wrap au-field-in">
          <div class="au-field-copy">
            <p class="au-cat" data-soft>{s.fullName}, {s.category.toLowerCase()} <Status id={s.id} status={s.status} /></p>
            <h2 id={`title-${s.id}`}>{s.headline.map((line) => <span class="ln"><span>{line}</span></span>)}</h2>
            <p class="au-lead" data-soft>{s.body}</p>
            <a class="text-link au-explore" href={`/${s.id}`} data-soft>Khám phá {s.name} <span class="round-arrow"><Icon name="external" size={17} /></span></a>
          </div>
        </div>
      </section>
    ))}

    <div class="au-rail" data-rail>
      <div class="wrap">
        <nav class="au-rail-nav" aria-label="Chuyển chương">
          {divisions.map((division) => <a href={`#chuong-${division.id}`} data-rail-link>{division.name}<i></i></a>)}
        </nav>
        <button type="button" class="au-motion" data-motion-toggle hidden aria-pressed="false">Giảm chuyển động</button>
      </div>
    </div>

    <section class="au-tail au-home-tail" id="linh-vuc" data-prism-tail aria-labelledby="ecosystem-title">
      <div class="wrap">
        <h2 id="ecosystem-title" data-lines><span class="ln"><span>Ba lĩnh vực</span></span><span class="ln"><span>cùng mở ra phía trước</span></span></h2>
        <p class="au-lead">Mỗi lĩnh vực có trọng tâm riêng, cùng hướng đến những giải pháp số có thể sử dụng trong thực tế.</p>
        <ul class="au-index">
          {divisions.map((division) => (
            <li class="au-index-summary">
              <h3>{division.fullName}</h3>
              <p>{division.description}</p>
              <Status id={division.id} status={division.status} />
            </li>
          ))}
        </ul>

        <div class="au-approach">
          <h2 id="approach-title" data-lines><span class="ln"><span>Bắt đầu bằng</span></span><span class="ln"><span>việc hiểu rõ hơn</span></span></h2>
          <a class="text-link" href="/ve-afyllx">Cách AFYLLX tiếp cận <span class="round-arrow"><Icon name="external" size={17} /></span></a>
        </div>
        <ol class="au-steps" aria-labelledby="approach-title">
          {approach.map((step) => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="au-end" data-prism-close aria-labelledby="connection-title">
      <div class="wrap">
        <h2 id="connection-title" data-lines><span class="ln"><span>Điều gì sẽ</span></span><span class="ln"><span>bắt đầu tiếp theo?</span></span></h2>
        <p class="au-lead">Chia sẻ nhu cầu của bạn. Cùng xác định một hướng đi.</p>
        <a class="button button-primary" href="/lien-he">Trao đổi với AFYLLX <Icon name="external" size={18} /></a>
        <div class="au-topics">{divisions.map((division) => <a href={`/lien-he?chu-de=${division.id}`}>{division.name}<Icon name="external" size={13} /></a>)}</div>
      </div>
    </section>
  </div>
</Site>
