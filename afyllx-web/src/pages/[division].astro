---
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import Status from '../components/Status.astro';
import Glass from '../aurora/Glass.astro';
import { divisions } from '../data.js';
export function getStaticPaths() {
  return divisions.map((division) => ({ params: { division: division.id }, props: { division } }));
}
const { division } = Astro.props;
const otherDivisions = divisions.filter((item) => item.id !== division.id);
---
<Site title={`${division.fullName} · ${division.category}`} description={division.description}>
  <div class="au au-home" data-aurora-zone data-focus={divisions.indexOf(division)}>
    <Glass />

    <section class="c2-hero sub-hero" aria-labelledby="page-title">
      <div class="wrap c2-copy">
        <nav class="au-crumbs" aria-label="Đường dẫn"><a href="/">AFYLLX</a><span aria-hidden="true">/</span><span aria-current="page">{division.name}</span></nav>
        <p class="au-cat" data-in>{division.fullName}, {division.category.toLowerCase()} <Status id={division.id} status={division.status} /></p>
        <h1 id="page-title"><span class="ln"><span>{division.title}</span></span></h1>
        <p class="au-lead" data-in>{division.description}</p>
        <div class="au-actions" data-in>
          <a class="button button-primary" href={division.destination}>{division.action} <Icon name="external" size={17} /></a>
          <a class="text-link" href="#chi-tiet">Trọng tâm <Icon name="down" size={16} /></a>
        </div>
      </div>
    </section>

    <section class="au-tail sub-tail" id="chi-tiet" aria-labelledby="focus-title">
      <div class="wrap">
        <div class="sub-split">
          <div>
            <h2 id="focus-title" data-lines><span class="ln"><span>{division.focusTitle}</span></span></h2>
            <p class="au-lead">{division.focus}</p>
          </div>
          <dl class="sub-facts">
            <div><dt>Phục vụ ai</dt><dd>{division.audience}</dd></div>
            <div><dt>Bước tiếp theo</dt><dd>{division.next}</dd></div>
          </dl>
        </div>

        <div class="sub-more">
          <h2 data-lines><span class="ln"><span>Các lĩnh vực khác</span></span></h2>
          <ul class="au-index">
            {otherDivisions.map((item) => (
              <li><a href={`/${item.id}`}>
                <h3>{item.fullName}</h3>
                <p>{item.description}</p>
                <Status id={item.id} status={item.status} />
                <span class="round-arrow"><Icon name="external" size={17} /></span>
              </a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </div>
</Site>
