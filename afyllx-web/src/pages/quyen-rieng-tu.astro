---
import Site from '../layouts/Site.astro';
import Glass from '../aurora/Glass.astro';
import { contactEmail } from '../data.js';
---
<Site title="Quyền riêng tư · AFYLLX" description="Cách website giới thiệu AFYLLX xử lý lựa chọn giao diện và nội dung liên hệ.">
  <div class="au au-home" data-aurora-zone>
    <Glass />

    <section class="c2-hero sub-hero sub-hero-short" aria-labelledby="page-title">
      <div class="wrap c2-copy">
        <nav class="au-crumbs" aria-label="Đường dẫn"><a href="/">AFYLLX</a><span aria-hidden="true">/</span><span aria-current="page">Quyền riêng tư</span></nav>
        <h1 id="page-title"><span class="ln"><span>Quyền riêng tư</span></span></h1>
      </div>
    </section>

    <section class="au-tail sub-tail">
      <div class="wrap sub-prose">
        <h2>Lựa chọn chuyển động</h2>
        <p>Website dùng cài đặt giảm chuyển động của thiết bị. Khi bạn đổi lựa chọn bằng nút trên trang chủ, website lưu lựa chọn đó trong trình duyệt để áp dụng cho lần truy cập tiếp theo.</p>
        <h2>Liên hệ qua email</h2>
        <p>Biểu mẫu trên website soạn sẵn nội dung trong ứng dụng email của bạn. AFYLLX nhận nội dung khi bạn gửi email.</p>
        <p><a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
      </div>
    </section>
  </div>
</Site>
