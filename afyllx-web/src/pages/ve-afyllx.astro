---
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import DepthVisual from '../components/DepthVisual.astro';
import { divisions } from '../data.js';
---
<Site title="Về AFYLLX" description="Tìm hiểu ba hướng phát triển của AFYLLX trong giáo dục, kinh doanh trực tuyến và khu vực công.">
  <section class="simple-hero about-hero"><DepthVisual /><div class="wrap"><span class="kicker"><span></span> VỀ AFYLLX</span><h1>Phát triển công nghệ từ nhu cầu thực tế</h1><p>AFYLLX bắt đầu với vận hành nhà trường. Hai hướng phát triển tiếp theo là kinh doanh website trực tuyến và chuyển đổi số chính phủ.</p></div></section>
  <section class="section-pad"><div class="wrap focus-grid"><div><span class="kicker"><span></span> CÁCH TIẾP CẬN</span><h2>Hiểu công việc trước khi chọn công nghệ</h2><p>AFYLLX xem xét ai thực hiện công việc, thông tin cần có ở mỗi bước và cách họ biết công việc đã hoàn thành. Những câu hỏi đó giúp xác định phần nào phù hợp để xây công cụ số trước.</p></div><div class="about-links">{divisions.map((division) => <a href={`/${division.id}`}><span class="mono">{division.number}</span><div><strong>{division.fullName}</strong><small>{division.status}</small></div><Icon name="external" size={20} /></a>)}</div></div></section>
</Site>
