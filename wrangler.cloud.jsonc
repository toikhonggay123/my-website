{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-website",
  "account_id": "dbe7e43add9b24b62bed8c25d05b419e",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {"pattern": "afyllx.com", "custom_domain": true}
  ],
  "preview_urls": false,
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "services": [{"binding": "AFYLLX_WEB", "service": "afyllx-web"}],
  "ratelimits": [
    {"name": "RL_PAGE", "namespace_id": "7101", "simple": {"limit": 200, "period": 10}},
    {"name": "RL_READ", "namespace_id": "7102", "simple": {"limit": 300, "period": 10}},
    {"name": "RL_WRITE", "namespace_id": "7103", "simple": {"limit": 100, "period": 10}},
    {"name": "RL_HEAVY", "namespace_id": "7104", "simple": {"limit": 60, "period": 60}},
    {"name": "RL_ENROLL", "namespace_id": "7105", "simple": {"limit": 20, "period": 60}},
    {"name": "RL_ENROLL_GLOBAL", "namespace_id": "7106", "simple": {"limit": 300, "period": 60}},
    {"name": "RL_DIRECTORY", "namespace_id": "7107", "simple": {"limit": 600, "period": 60}}
  ],
  "vars": {
    "MEALCHECK_DEPLOYMENT": "cloud-live",
    "MEALCHECK_PUBLIC_HOST": "edu.afyllx.com",
    "MEALCHECK_PUBLIC_HOST_ALIASES": "afyllx.com,my-website.fyllxestonia.workers.dev"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "afyllx-mealcheck-live-20261031",
    "database_id": "34ef2bb4-c150-4464-b532-0ceae01cc5f7",
    "migrations_dir": "drizzle"
  }]
}
