{
  // Local and QA configuration for AFYLLX Account. The live Worker uses cloud/wrangler.jsonc.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "afyllx-accounts-local",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "APP_ORIGIN": "http://127.0.0.1:5190" },
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "517410", "simple": { "limit": 10, "period": 60 } }
  ],
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "ACCOUNTS_DB",
      "database_name": "afyllx-accounts-local",
      "database_id": "00000000-0000-4000-8000-000000005190",
      "migrations_dir": "migrations"
    }
  ]
}
