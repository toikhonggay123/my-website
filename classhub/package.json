{
  "name": "afyllx-classhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "start": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "db:local": "wrangler d1 migrations apply CLASSHUB_DB --local --config wrangler.jsonc",
    "setup:local": "node scripts/local.mjs setup",
    "invite:owner": "node scripts/local.mjs invite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:cloud": "node scripts/build-cloud.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "better-auth": "1.7.17",
    "hono": "4.13.16",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.18.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "1.59.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "miniflare": "4.20260515.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
