{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "afyllx-classhub",
  "account_id": "dbe7e43add9b24b62bed8c25d05b419e",
  "main": "../src/server/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ORIGIN": "https://edu.afyllx.com",
    "APP_BASE_PATH": "/classhub",
    "MEALCHECK_DIRECTORY_ORIGIN": "https://my-website.fyllxestonia.workers.dev",
    "MEALCHECK_DIRECTORY_ORG_ID": "51740000-0000-4000-8000-000000000002",
    // Public student timetable answers stay in the edge cache for 60 s (src/server/public.ts). Absent locally and in QA.
    "PUBLIC_EDGE_CACHE": "1"
  },
  "services": [
    { "binding": "MEALCHECK_DIRECTORY", "service": "my-website" },
    // AFYLLX Account: Founder and platform administrators sign in to ClassHub with it (src/server/platform.ts).
    { "binding": "ACCOUNTS", "service": "afyllx-accounts" }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "ratelimits": [
    { "name": "ACTIVATION_LIMIT", "namespace_id": "517402", "simple": { "limit": 12, "period": 60 } },
    // Flood limit for every /api/* request per client IP (IPv6 per /64), src/server/edge.ts. Fails open.
    { "name": "API_LIMIT", "namespace_id": "517420", "simple": { "limit": 300, "period": 10 } }
  ],
  "d1_databases": [
    {
      "binding": "CLASSHUB_DB",
      "database_name": "afyllx-classhub-live",
      "database_id": "c7ccc14f-6786-4034-b73b-81baf87381de",
      "migrations_dir": "../migrations"
    },
    {
      "binding": "CLASSHUB_DEMO_DB",
      "database_name": "afyllx-classhub-demo",
      "database_id": "be6a15e4-566c-4e71-b0a0-51665ca6cfda",
      "migrations_dir": "../migrations"
    }
  ]
}
