# Workers Static Assets headers for the ClassHub pages. On edu.afyllx.com the Edu gateway removes /classhub before
# forwarding, so the asset paths seen here start at / and /* covers every page and file. Nothing frames ClassHub,
# so framing stays refused everywhere (frame-ancestors 'none', X-Frame-Options DENY).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
