{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "afyllx-classhub-local",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    { "name": "ACTIVATION_LIMIT", "namespace_id": "517401", "simple": { "limit": 12, "period": 60 } }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "CLASSHUB_DB",
      "database_name": "afyllx-classhub-local",
      "database_id": "00000000-0000-4000-8000-000000005174",
      "migrations_dir": "migrations"
    }
  ]
}
